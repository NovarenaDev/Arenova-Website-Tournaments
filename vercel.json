{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://16.112.182.86/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!admin).*)",
      "destination": "/index.html"
    }
  ]
}

