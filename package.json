{
  "name": "arenova-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm --prefix admin install",
    "dev": "concurrently -n \"web,admin\" -c \"cyan,magenta\" \"vite\" \"npm --prefix admin run dev\"",
    "dev:web": "vite",
    "dev:admin": "npm --prefix admin run dev",
    "build:web": "vite build",
    "build:admin": "npm --prefix admin install && npm --prefix admin run build",
    "build": "vite build && npm --prefix admin install && npm --prefix admin run build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.17.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.6",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0"
  }
}
